{
  "name": "nova-wing-desk",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev -w @nova-wing-desk/web",
    "dev:api": "npm run start:dev -w @nova-wing-desk/api",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "check": "npm run typecheck && npm run test && npm run build"
  }
}
